# Mentora Frontend Environment Variables
# Copy this file to .env.local (local dev) or set in your Vercel project's
# Environment Variables (production/preview) with your FastAPI backend URL.
#
# IMPORTANT: must be the BARE origin — the client appends /api/v1 itself.
#   correct:   https://mentora-backend-7.onrender.com
#   incorrect: https://mentora-backend-7.onrender.com/api/v1

VITE_API_URL=http://localhost:8000